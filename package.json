{
  "name": "memberry",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/neo4j",
    "packages/redis",
    "packages/mcp",
    "packages/research",
    "packages/arch",
    "packages/code",
    "packages/retrieval",
    "packages/wiki",
    "packages/graph"
  ],
  "scripts": {
    "build": "node scripts/clean-build-artifacts.mjs && tsc -b tsconfig.build.json",
    "test": "npm run build && npm run test --workspaces --if-present",
    "dev": "tsx packages/mcp/src/server.ts",
    "setup": "bash scripts/setup.sh",
    "smoke": "node scripts/smoke.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "start": "tsx packages/mcp/src/server.ts",
    "stack:up": "docker compose --profile app up -d --build",
    "stack:down": "docker compose --profile app down",
    "stack:logs": "docker compose --profile app logs -f mcp",
    "bench:quality": "tsx bench/quality/eval.ts",
    "bench:performance": "tsx packages/retrieval/bench/benchmark.ts",
    "bench:lab": "tsx bench/lab/cli.ts",
    "bench:lab:test": "vitest run bench/lab",
    "bench:lab:typecheck": "tsc --noEmit --strict --target ES2022 --module Node16 --moduleResolution Node16 --esModuleInterop --skipLibCheck bench/lab/index.ts bench/lab/cli.ts bench/lab/live-smoke.ts",
    "bench:lab:validate": "tsx bench/lab/registry/validate.ts",
    "bench:lab:baseline:verify": "tsx bench/lab/baselines/verify.ts",
    "bench:lab:dataset:acquire": "tsx bench/lab/datasets/acquire.ts",
    "bench:lab:ci": "tsx bench/lab/baselines/ci-gate.ts",
    "bench:lab:live": "tsx bench/lab/live-smoke.ts",
    "validate:memberry-guidance": "node skills/memberry/scripts/validate-source-guidance.mjs && node skills/memberry/scripts/validate-project-config.mjs .cursorrules"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "vite": "^6.4.3"
  },
  "dependencies": {
    "tsx": "^4.0.0"
  }
}
